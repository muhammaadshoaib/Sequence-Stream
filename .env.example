# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Sequence Stream - AWS Integration Configuration
# Local browser analysis runs out of the box without requiring AWS credentials.
# Connect these endpoints for enterprise cloud deployment:
VITE_AWS_S3_BUCKET="sequence-stream-dna-raw-sequences-uni"
VITE_AWS_API_GATEWAY_URL="https://api.sequencestream.edu/v1"
VITE_AWS_REGION="us-east-1"
VITE_AWS_ANALYSIS_ENDPOINT="/analyze/batch-workflow"
VITE_AWS_BATCH_QUEUE="sequence-stream-highmem-queue"

